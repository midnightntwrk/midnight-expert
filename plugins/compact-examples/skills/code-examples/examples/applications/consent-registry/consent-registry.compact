// This file is part of example-consent-registry.
// SPDX-License-Identifier: Apache-2.0
//
// Consent registry for data-protection law (LGPD Art. 7-8, GDPR Art. 6(1)(a) and Art. 7).
// Adapted from DPO2U's ConsentRegistry (github.com/fredericosanntana/dpo2u-midnight).
//
// What it shows:
//   - Controller authority derived in-circuit from a witness secret (no ownPublicKey()).
//   - Data subjects keyed by a SALTED hash: a bare hash of an e-mail or national ID is
//     low-entropy and can be reversed by guessing, so the salt stays with the controller.
//   - Purpose-specific consent as a Uint<8> bitmask, plus the policy version consented to.
//   - Revocation keeps the record (status 2): the withdrawal itself is auditable.
//   - Every value that reaches public state goes through an explicit disclose().
//
// Purposes (bitmask): 1 essential, 2 analytics, 4 marketing, 8 third-party sharing, 16 profiling.
// Status: 0 no record, 1 active, 2 revoked.
//
// Privacy model (read before reusing):
//   - The consent history of each subject_id is public and permanent. subject_id is a stable
//     pseudonym: anyone holding the controller's salt can link it back to a person, so the salt is
//     the real secret. Destroying the salt is how erasure works here; rotate it per policy.
//   - Consent is the controller's statement, not proven by the subject. To make it subject-signed,
//     add a subject witness and verify it in grantConsent.
//   - The get* circuits disclose the subject being queried. Read the ledger state off-chain
//     (indexer) instead of calling them in a transaction when the lookup itself is sensitive.

pragma language_version 0.23;
import CompactStandardLibrary;

witness controllerSecret(): Bytes<32>;

export sealed ledger controller: Bytes<32>;
export ledger consentStatus: Map<Bytes<32>, Uint<8>>;
export ledger consentPurposes: Map<Bytes<32>, Uint<8>>;
export ledger consentPolicyVersion: Map<Bytes<32>, Uint<8>>;
export ledger totalGrants: Counter;
export ledger totalRevocations: Counter;

export pure circuit deriveControllerKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "consent:controller:v1"), sk]);
}

// subject_id = H(domain, salt, H(normalized identifier)). Computed off-chain with the same circuit.
export pure circuit subjectKey(identifierHash: Bytes<32>, salt: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "consent:subject:v1"), salt, identifierHash]);
}

constructor() {
  controller = disclose(deriveControllerKey(controllerSecret()));
}

circuit assertController(): [] {
  assert(deriveControllerKey(controllerSecret()) == controller, "Only the controller can do this");
}

export circuit grantConsent(subjectId: Bytes<32>, purposes: Uint<8>, policyVersion: Uint<8>): [] {
  assertController();
  assert(purposes > 0, "Must grant at least one purpose");
  assert(purposes < 32, "Unknown purpose bit");
  assert(policyVersion > 0, "Policy version must be specified");
  const id = disclose(subjectId);
  if (consentPolicyVersion.member(id)) {
    assert(disclose(policyVersion) >= consentPolicyVersion.lookup(id), "Policy version cannot go back");
  }
  consentStatus.insert(id, 1);
  consentPurposes.insert(id, disclose(purposes));
  consentPolicyVersion.insert(id, disclose(policyVersion));
  totalGrants.increment(1);
}

// Narrow consent without revoking it (e.g. drop marketing, keep essential).
export circuit updatePurposes(subjectId: Bytes<32>, purposes: Uint<8>, policyVersion: Uint<8>): [] {
  assertController();
  const id = disclose(subjectId);
  assert(consentStatus.member(id), "No consent record for this subject");
  assert(consentStatus.lookup(id) == 1, "Consent is revoked; use grantConsent to re-consent");
  assert(purposes > 0, "Use revokeConsent to remove every purpose");
  assert(purposes < 32, "Unknown purpose bit");
  assert(disclose(policyVersion) >= consentPolicyVersion.lookup(id), "Policy version cannot go back");
  consentStatus.insert(id, 1);
  consentPurposes.insert(id, disclose(purposes));
  consentPolicyVersion.insert(id, disclose(policyVersion));
}

// Withdrawal must be as easy as granting (LGPD Art. 8 §5, GDPR Art. 7(3)).
export circuit revokeConsent(subjectId: Bytes<32>): [] {
  assertController();
  const id = disclose(subjectId);
  assert(consentStatus.member(id), "No consent record for this subject");
  assert(consentStatus.lookup(id) == 1, "Consent already revoked");
  consentStatus.insert(id, 2);
  consentPurposes.insert(id, 0);
  totalRevocations.increment(1);
}

// Reads guard with member(): Map.lookup requires the key to exist.
export circuit getStatus(subjectId: Bytes<32>): Uint<8> {
  const id = disclose(subjectId);
  if (consentStatus.member(id)) {
    return consentStatus.lookup(id);
  } else {
    return 0;
  }
}

export circuit getPurposes(subjectId: Bytes<32>): Uint<8> {
  const id = disclose(subjectId);
  if (consentPurposes.member(id)) {
    return consentPurposes.lookup(id);
  } else {
    return 0;
  }
}

export circuit getPolicyVersion(subjectId: Bytes<32>): Uint<8> {
  const id = disclose(subjectId);
  if (consentPolicyVersion.member(id)) {
    return consentPolicyVersion.lookup(id);
  } else {
    return 0;
  }
}
